{
  "name": "@cursor-crew/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm db:migrate && wrangler dev --port 8787",
    "preview": "pnpm db:migrate && wrangler dev --port 4173",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply portfolio --local",
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@cursor-crew/shared": "workspace:*",
    "@hono/zod-validator": "0.9.1",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.20",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.1.1",
    "wrangler": "4.166.0"
  }
}
