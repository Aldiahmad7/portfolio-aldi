// One Worker serves the web build and /api/* (ADR-0004). Secrets live in .dev.vars locally and in
// `wrangler secret put` in production, never here.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cursor-crew",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-20",
  "assets": {
    "directory": "../web/dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "portfolio",
      // Placeholder for local development; the real id is set when the database is created (Phase 6).
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations",
    },
  ],
  // Limits per IP and route (docs/backend-api.md §5). The binding only supports 10 or 60 second periods.
  "ratelimits": [
    {
      "name": "RATE_LIMIT_COMMENTS",
      "namespace_id": "1001",
      "simple": { "limit": 3, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_CONTACT",
      "namespace_id": "1002",
      "simple": { "limit": 2, "period": 60 },
    },
    {
      "name": "RATE_LIMIT_BUILDS",
      "namespace_id": "1003",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "vars": {
    "ALLOWED_ORIGINS": "http://localhost:5173",
    "CONTACT_TO_EMAIL": "",
    "CONTACT_FROM_EMAIL": "",
  },
}
